# --- Sun'iy intellekt provayderi: claude yoki openai ---
LLM_PROVIDER=openai

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5

# Claude (Anthropic): https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Telegram bot ---
# @BotFather orqali bot yarating va tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=123456:ABC...
# Botga /start yozing - u sizning chat ID'ingizni aytadi
TELEGRAM_CHAT_ID=

# --- YouTube ---
# Google Cloud Console -> OAuth client (Desktop app) JSON fayli
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# 28 = Science & Technology, 27 = Education
YOUTUBE_CATEGORY_ID=28

# --- Jadval ---
TIMEZONE=Asia/Tashkent
PUBLISH_DAYS=mon,tue,thu,sat
PUBLISH_TIME=19:00
# Video necha soat oldin tayyorlanib, Telegram'ga tasdiqlash uchun yuboriladi
PREPARE_HOURS_BEFORE=3
# Kommentlar necha daqiqada bir tekshiriladi
COMMENT_CHECK_MINUTES=30
COMMENT_LOOKBACK_DAYS=3

# --- Kontent ---
VIDEO_LANGUAGE=o'zbek
TTS_VOICE=uz-UZ-SardorNeural
TOPICS=Tibbiyot,Ilm-fan,Sun'iy intellekt,Qiziqarli faktlar
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
FONT_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
DATA_DIR=data
