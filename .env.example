# ======================================================================
# Nusxa oling:  copy .env.example .env   (Windows)  |  cp .env.example .env
# Kalitlarni yozish:  python -m youtube_agent set-key NOM
# Bu faylni hech kimga yubormang va GitHub'ga yuklamang (.gitignore'da bor).
# ======================================================================

# --- Sun'iy intellekt (matn, fakt-tekshiruv, kadrlarni baholash) ---
LLM_PROVIDER=openai                # openai yoki claude
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5                 # asosiy model (tadqiqot, ssenariy)
OPENAI_CHEAP_MODEL=gpt-5-mini      # arzon model (kadr mosligini tekshirish, kommentlar)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_CHEAP_MODEL=claude-haiku-5-5

# --- O'zbekcha ovoz (TTS) ---
TTS_PROVIDER=openai                # openai yoki edge (Microsoft, bepul)
OPENAI_TTS_VOICE=marin             # marin, cedar, coral, ash, sage... (tts-benchmark bilan solishtiring)
TTS_MODEL=gpt-4o-mini-tts
TTS_INSTRUCTIONS=                  # bo'sh bo'lsa - standart "hujjatli film hikoyachisi" uslubi
EDGE_TTS_VOICE=uz-UZ-SardorNeural  # TTS_PROVIDER=edge bo'lganda
USE_ASR=1                          # whisper bilan subtitr vaqtini moslash va talaffuzni tekshirish (OpenAI kaliti kerak)
PRONUNCIATION_FILE=data/pronunciation.json   # o'z talaffuz lug'atingiz (ixtiyoriy)

# --- Vizuallar ---
PIXABAY_API_KEY=                   # https://pixabay.com/api/docs/ (bepul)
PEXELS_API_KEY=                    # https://www.pexels.com/api/ (bepul; yangi kalit berish vaqtincha to'xtagan bo'lishi mumkin)
ALLOW_PUBLISHER_IMAGES=1           # yangilik sahifasining asosiy rasmi (huquqi tekshirilmagan - QA ogohlantiradi)
VISION_CHECK=1                     # har kadrni AI ko'zi bilan tekshirish (aloqasiz kadrlarni rad etadi)
VISUAL_MIN_SCORE=6
AI_VIDEO_PROVIDER=none             # none yoki sora (pullik! ~$0.10/soniya)
AI_VIDEO_MODEL=sora-2

# --- Audio ---
MUSIC_DIR=music                    # music/<kayfiyat>/*.mp3 yoki music/*.mp3 (faqat litsenziyali musiqa!)
MUSIC_DB=-22
SFX_DIR=sfx                        # sfx/whoosh.mp3, sfx/impact.mp3 ... (ixtiyoriy)
TARGET_LUFS=-14

# --- Davomiylik va sifat nazorati ---
SHORT_MIN_SECONDS=25
SHORT_MAX_SECONDS=55
MAX_CORRECTIONS=2                  # QA'dan o'tmasa nechta avtomatik tuzatish
QA_MIN_VISUAL=7
QA_MIN_AUDIO=7
QA_MIN_STORY=6
QA_MIN_SUBTITLE=6
QA_MIN_TECHNICAL=7

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube ---
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_CATEGORY_ID=28             # 28 = Science & Technology
YOUTUBE_PRIVACY=private            # private (sinov) | unlisted | public | scheduled (jadval vaqtida ochiladi)

# --- Jadval va mavzular ---
TIMEZONE=Asia/Tashkent
PUBLISH_DAYS=mon,tue,thu,sat
PUBLISH_TIME=19:00
PREPARE_HOURS_BEFORE=3
COMMENT_CHECK_MINUTES=30
COMMENT_LOOKBACK_DAYS=3
TOPICS=Sun'iy intellekt,Yangi texnologiyalar,Yangi mashinalar,Ilm-fan,Ta'lim

# --- Narxlar (taxminiy hisob uchun, USD) ---
# PRICE_GPT_5=1.25,10
# PRICE_TTS_PER_MIN=0.015
# PRICE_SORA_PER_SEC=0.10

# Shriftlar avtomatik tanlanadi (Windows: Arial + Impact). Boshqasini xohlasangiz:
# FONT_PATH=C:\Windows\Fonts\arial.ttf
# FONT_BOLD_PATH=C:\Windows\Fonts\arialbd.ttf
# HEADLINE_FONT_PATH=C:\Windows\Fonts\impact.ttf
DATA_DIR=data
