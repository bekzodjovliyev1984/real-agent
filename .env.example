# --- Sun'iy intellekt provayderi: claude yoki openai ---
LLM_PROVIDER=openai

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5

# Claude (Anthropic): https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Telegram bot ---
# @BotFather orqali bot yarating va tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=123456:ABC...
# Botga /start yozing - u sizning chat ID'ingizni aytadi
TELEGRAM_CHAT_ID=

# --- YouTube ---
# Google Cloud Console -> OAuth client (Desktop app) JSON fayli
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# 28 = Science & Technology, 27 = Education
YOUTUBE_CATEGORY_ID=28

# --- Jadval ---
TIMEZONE=Asia/Tashkent
PUBLISH_DAYS=mon,tue,thu,sat
PUBLISH_TIME=19:00
# Video necha soat oldin tayyorlanib, Telegram'ga tasdiqlash uchun yuboriladi
PREPARE_HOURS_BEFORE=3
# Kommentlar necha daqiqada bir tekshiriladi
COMMENT_CHECK_MINUTES=30
COMMENT_LOOKBACK_DAYS=3

# --- Rasmlar ---
# Rasmlar avtomatik olinadi: yangilik sahifasining asosiy rasmi, NASA arxivi, Wikimedia Commons.
# Topilmasa OpenAI rasm chizsin (pullik, ~0.04$/rasm): 1 = yoqish
AI_IMAGES=0
# Oxirgi chora sifatida Pixabay stok-rasmlari (mavzuga to'liq mos kelmasligi mumkin): 1 = yoqish
STOCK_FALLBACK=0
PIXABAY_API_KEY=
# Fon musiqasi: shu papkaga mualliflik huquqisiz .mp3 fayllar qo'ying (YouTube Audio Library)
MUSIC_DIR=music
# Diktor tezligi (Shorts uchun biroz tezroq)
TTS_RATE=+8%

# --- Kontent ---
VIDEO_LANGUAGE=o'zbek
TTS_VOICE=uz-UZ-SardorNeural
TOPICS=Koinot,Sun'iy intellekt,Tibbiyot,Ilm-fan
# Shrift avtomatik tanlanadi (Windows: Arial). Boshqasini xohlasangiz:
# FONT_PATH=C:\Windows\Fonts\arial.ttf
# FONT_BOLD_PATH=C:\Windows\Fonts\arialbd.ttf
DATA_DIR=data
